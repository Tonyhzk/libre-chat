#=====================================================================#
#                Libre Chat Studio Test Environment                #
#=====================================================================#

HOST=localhost
PORT=3081

MONGO_URI=mongodb://127.0.0.1:27018/LibreChatTest
DOMAIN_CLIENT=http://localhost:3081
DOMAIN_SERVER=http://localhost:3081

NO_INDEX=true
TRUST_PROXY=1
CONSOLE_JSON=false
DEBUG_LOGGING=true
DEBUG_CONSOLE=false
LOG_TO_FILE=true

# Test-only values. Replace before any shared deployment.
CREDS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CREDS_IV=0123456789abcdef0123456789abcdef
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Search
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://127.0.0.1:17700
MEILI_MASTER_KEY=libre-chat-test-meili-key

# RAG
RAG_API_URL=http://127.0.0.1:18000
RAG_PORT=8000
# RAG_OPENAI_BASEURL=
# RAG_OPENAI_API_KEY=
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small

# Redis is optional for LibreChat. Enable it when testing cache/session behavior.
USE_REDIS=true
REDIS_URI=redis://127.0.0.1:16380

# Registration and Login
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7
SESSION_COOKIE_SECURE=false

# LLM providers. Prefer user-provided keys in test.
ANTHROPIC_API_KEY=user_provided
GOOGLE_KEY=user_provided
OPENAI_API_KEY=user_provided
OPENAI_REVERSE_PROXY=https://aiapi.moviefilmer.com/v1
OPENAI_MODELS=mimo-v2.5-pro
ASSISTANTS_API_KEY=user_provided

# Moderation / limits
OPENAI_MODERATION=false
BAN_VIOLATIONS=true
LOGIN_MAX=7
LOGIN_WINDOW=5
REGISTER_MAX=5
REGISTER_WINDOW=60
LIMIT_CONCURRENT_MESSAGES=true
CONCURRENT_MESSAGE_MAX=2
LIMIT_MESSAGE_IP=true
MESSAGE_IP_MAX=40
MESSAGE_IP_WINDOW=1
LIMIT_MESSAGE_USER=false
MESSAGE_USER_MAX=40
MESSAGE_USER_WINDOW=1

# UI
APP_TITLE=Libre Chat Studio Test
HELP_AND_FAQ_URL=https://librechat.ai
ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=false

# Optional auth providers are disabled until explicitly configured.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_CREDENTIALS=
LDAP_USER_SEARCH_BASE=

OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_ISSUER=
OPENID_SESSION_SECRET=
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_AUTO_REDIRECT=false
OPENID_USE_PKCE=false
OPENID_REUSE_TOKENS=

SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CERT=
SAML_CALLBACK_URL=/oauth/saml/callback
SAML_SESSION_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=/oauth/github/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=/oauth/discord/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=/oauth/facebook/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_CALLBACK_URL=/oauth/apple/callback
